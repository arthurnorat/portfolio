{#- Small inline SVG icons (stroke style), decorative only. Usage: {{ icon("calendar") }} -#}
{% macro icon(name) %}
<svg class="icon-inline" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if name == "calendar" %}<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
{% elif name == "code" %}<path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/>
{% elif name == "branch" %}<path d="M6 3v12"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/>
{% endif %}
</svg>
{% endmacro %}

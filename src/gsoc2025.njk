---
# One template, three pages: Eleventy repeats it once per entry of `languages`.
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}gsoc2025.html"
pageTitle: "GSoC 2025 - VideoLAN | Arthur Norat"
switchTarget: "gsoc2025.html"
---
{% set t = i18n[lang.code] %}
{% extends "layouts/base.njk" %}

{% block navLinks %}
            <li><a href="{{ lang.root }}{{ lang.path }}">{{ t.nav.portfolio }}</a></li>
{% endblock %}

{% block content %}
<!-- PROJECT HEADER -->

    <section id="project-header">
        <div class="header-container">
            <div class="header-content">
                <div class="header-text">
                    <p class="project-category">{{ t.gsoc.category }}</p>
                    <h1 class="project-title">{{ t.gsoc.title }}</h1>
                    <div class="project-meta">
                        <span class="meta-item">
                            <i class='bx bx-calendar'></i>
                            {{ t.gsoc.dates }}
                        </span>
                        <span class="meta-item">
                            <i class='bx bx-code-alt'></i>
                            {{ t.gsoc.stack }}
                        </span>
                        <span class="meta-item">
                            <i class='bx bx-git-branch'></i>
                            {{ t.gsoc.openSource }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

<!-- PROJECT LINKS -->

    <section id="project-links">
        <div class="btn-container">
            <a href="{{ site.vlcMergeRequest }}" target="_blank" rel="noopener noreferrer">
                <button class="btn-1">{{ t.gsoc.viewGitlab }}</button>
            </a>
            <a href="{{ site.gsocProjectPage }}" target="_blank" rel="noopener noreferrer">
                <button class="btn-2">{{ t.gsoc.projectPage }}</button>
            </a>
        </div>
    </section>

<!-- ARTICLE CONTENT -->

    <section id="article-content">
        <div class="article-container">
            <div class="article-body">
{% include "gsoc/" + lang.code + ".html" %}
            </div>
        </div>
    </section>
{% endblock %}

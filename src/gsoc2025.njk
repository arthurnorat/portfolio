---
# One template, three pages: Eleventy repeats it once per entry of `languages`.
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}gsoc2025.html"
pageKind: gsoc
switchTarget: "gsoc2025.html"
---
{%- set t = i18n[lang.code] -%}
{%- from "partials/icons.njk" import icon -%}
{% extends "layouts/base.njk" %}

{% block navLinks %}
            <li><a href="{{ lang.root }}{{ lang.path }}">{{ t.nav.portfolio }}</a></li>
{% endblock %}

{% block content %}
<section class="page-header" aria-labelledby="page-title">
    <p class="eyebrow">{{ t.gsoc.category }}</p>
    <h1 id="page-title" class="page-title">{{ t.gsoc.title }}</h1>
    <ul class="meta">
        <li>{{ icon("calendar") }} {{ t.gsoc.dates }}</li>
        <li>{{ icon("code") }} {{ t.gsoc.stack }}</li>
        <li>{{ icon("branch") }} {{ t.gsoc.openSource }}</li>
    </ul>
    <div class="btn-group">
        <a class="btn" href="{{ site.vlcMergeRequest }}" target="_blank" rel="noopener noreferrer">{{ t.gsoc.viewGitlab }}</a>
        <a class="btn" href="{{ site.gsocProjectPage }}" target="_blank" rel="noopener noreferrer">{{ t.gsoc.projectPage }}</a>
    </div>
</section>

<article class="article">
{% include "gsoc/" + lang.code + ".html" %}
</article>
{% endblock %}

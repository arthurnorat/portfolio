---
# One template, three pages: Eleventy repeats it once per entry of `languages`.
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ lang.path }}index.html"
pageTitle: "Arthur Norat"
switchTarget: ""
---
{% set t = i18n[lang.code] %}
{% extends "layouts/base.njk" %}

{% block navLinks %}
            <li><a href="#projects">{{ t.nav.projects }}</a></li>
            <li><a href="#experience">{{ t.nav.experience }}</a></li>
            <li><a href="#about">{{ t.nav.about }}</a></li>
{% endblock %}

{% block content %}
<!-- HERO SECTION -->

    <section id="hero">
        <div class="hero-text">
            <p class="p1">{{ t.hero.greeting }}</p>
            <h1 class="title">Arthur</h1>
            <p class="p2">{{ t.hero.role }}</p>
            <div class="btn-container">
                <button class="btn-1">{{ t.hero.resume }}</button>
                <button class="btn-2">{{ t.hero.contact }}</button>
            </div>
            <div id="socials-container">
                <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer">
                    <img
                        src="{{ lang.root }}assets/linkedin.png"
                        alt="{{ t.hero.linkedinAlt }}"
                        class="icon">
                </a>
                <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer">
                    <img
                        src="{{ lang.root }}assets/github.png"
                        alt="{{ t.hero.githubAlt }}"
                        class="icon">
                </a>
            </div>
        </div>
        <div class="pic-container">
            <img src="{{ lang.root }}assets/headshot.png" alt="{{ t.hero.photoAlt }}">
        </div>
    </section>

<!-- PROJECTS -->

    <section id="projects">
        <p class="section_text_p1">{{ t.projects.eyebrow }}</p>
        <h1 class="section_title">{{ t.projects.title }}</h1>
        <div class="projects-container">
            {% for project in projects %}
            {% set pictures %}
                <div class="pic-container">
                    {% for image in project.images %}
                    <img src="{{ lang.root }}assets/{{ image }}" alt="{{ project.name }}">
                    {% endfor %}
                </div>
            {% endset %}
            {% set text %}
                <div class="{{ 'project-text' if project.imagesFirst else 'project-text-right' }}">
                    <h3>{{ project.name }}</h3>
                    <p>{{ t.projects.descriptions[loop.index0] }}</p>
                    <div class="btn-container">
                        <button class="btn-1">{{ t.projects.github }}</button>
                        <button class="btn-2">{{ t.projects.liveDemo }}</button>
                    </div>
                </div>
            {% endset %}
            <div class="project-item">
                {% if project.imagesFirst %}{{ pictures | safe }}{{ text | safe }}{% else %}{{ text | safe }}{{ pictures | safe }}{% endif %}
            </div>
            {% endfor %}
        </div>
    </section>

<!-- EXPERIENCE -->

    <section id="experience">
        <p class="section_text_p1">{{ t.experience.eyebrow }}</p>
        <h1 class="section_title">{{ t.experience.title }}</h1>
        <div class="experience-container">
            <div class="experience-item">
                <div class="pic-container">
                    <img src="{{ lang.root }}assets/vlc.png" alt="VideoLAN">
                </div>
                <div class="experience-text">
                    <h3>GSoC 2025, VideoLAN</h3>
                    <p>{{ t.experience.description }}</p>
                    <div class="btn-container">
                        <a href="{{ lang.root }}{{ lang.path }}gsoc2025.html">
                            <button class="btn-1">{{ t.experience.evaluation }}</button>
                        </a>
                        <a href="{{ site.vlcMergeRequest }}" target="_blank" rel="noopener noreferrer">
                            <button class="btn-2">{{ t.experience.viewCode }}</button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

<!-- ABOUT ME -->

    <section id="about">
        <div class="about-container">
            <div class="about-image">
                <img src="{{ lang.root }}assets/headshot.png" alt="{{ site.name }}">
            </div>
            <div class="about-text">
                <h2>{{ t.about.title }}</h2>
                {% for paragraph in t.about.paragraphs %}
                <p>{{ paragraph }}</p>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
